---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import site from '../../content/site.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const p = post.data;
const org = { '@type': 'Organization', name: site.name, url: site.url };
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: p.title,
  description: p.description,
  image: new URL(p.image.src, Astro.site).href,
  author: org,
  publisher: org,
  ...(p.date && { datePublished: p.date.toISOString() }),
};
---

<Base title={p.seoTitle} description={p.description} image={p.image.src}>
  <PageHero title={p.title} image={p.image} crumbs={[['Blog', '/blog'], [p.title, `/blog/${post.id}`]]}>
    <p class="eyebrow mt-8 text-muted">By {site.name}{p.date && ` · ${p.date.toLocaleDateString('en-GB', { dateStyle: 'long' })}`}</p>
  </PageHero>

  <article class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
    <div class="prose mx-auto text-fg/80"><Content /></div>
    <aside class="mx-auto mt-16 max-w-[68ch] border-l-4 border-green bg-surface p-8">
      <h2 class="display text-4xl">Want a plan made for you?</h2>
      <p class="mt-3 text-lg text-fg/75">Train one-to-one at your home, outdoors or in the gym. Your first session is free.</p>
      <div class="mt-6 flex flex-wrap items-center gap-6">
        <a href="/book-a-trial" class="btn">Book a free trial <Icon name="arrow" /></a>
        <a href="/#services" class="link">See our services</a>
      </div>
    </aside>
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>
