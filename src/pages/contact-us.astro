---
import Base from '../layouts/Base.astro';
import photo from '../assets/photos/trainer-gym.jpg';
import PageHero from '../components/PageHero.astro';
import WaForm from '../components/WaForm.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';

const ways = [
  ['phone', 'Call', site.phone, `tel:${site.tel}`],
  ['clock', 'Hours', site.hoursText, ''],
  ['mail', 'Email', site.email, `mailto:${site.email}`],
  ['pin', 'Based in', `${site.city}, UAE`, ''],
] as const;
const hours = site.hoursText.replace('Every day', 'every day');
const field = 'w-full border border-line bg-ink px-4 py-3.5 text-fg placeholder:text-muted focus:border-green focus:outline-none';
const label = 'mb-2 block font-semibold text-fg/85';
const schema = { '@context': 'https://schema.org', '@type': 'ContactPage', name: `Contact ${site.name}`, url: new URL('/contact-us', Astro.site).href };
---

<Base title="Contact a Personal Trainer in Abu Dhabi" description={`Contact ${site.name} in ${site.city}. WhatsApp or call ${site.phone}, or email ${site.email}. Open ${hours}.`}>
  <PageHero title="Contact us" image={photo} crumbs={[['Contact', '/contact-us']]} intro={`The fastest way to reach us is WhatsApp. We reply ${hours}.`} />

  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:py-28">
    <div class="grid content-start gap-3">
      <a href={site.whatsappUrl} class="group flex items-center justify-between gap-6 bg-green p-6 text-ink sm:p-8">
        <span>
          <span class="eyebrow block">WhatsApp</span>
          <span class="display mt-2 block text-[clamp(1.75rem,9vw,3rem)] whitespace-nowrap">{site.phone}</span>
        </span>
        <Icon name="arrow" class="size-8 shrink-0 transition group-hover:translate-x-2" />
      </a>
      <ul class="grid gap-3 sm:grid-cols-2">
        {ways.map(([icon, name, value, href], i) => {
          const Card = href ? 'a' : 'div'; // the whole card is the tap target, not just the number or address
          return (
            <li class:list={['min-w-0 border border-line bg-surface', href && 'transition-colors hover:border-green active:bg-white/5', i > 1 && 'sm:col-span-2']}>
              <Card href={href || undefined} class="group block h-full p-6">
                <Icon name={icon} class="size-6 text-green" />
                <p class="eyebrow mt-4 text-muted">{name}</p>
                <p class:list={['mt-1 text-base font-bold [overflow-wrap:anywhere] sm:text-lg', href && 'group-hover:text-green']}>{value}</p>
              </Card>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="border border-line p-6 sm:p-8">
      <h2 class="display text-5xl">Send a message</h2>
      <WaForm intro="Hi Muscularity Fitness," class="mt-8 grid gap-6">
        <label><span class={label}>Your name</span><input name="Name" required autocomplete="name" autocapitalize="words" class={field} /></label>
        <label><span class={label}>Message</span><textarea name="Message" required rows="5" class={field}></textarea></label>
        <div class="flex flex-wrap items-center gap-6">
          <button class="btn">Send on WhatsApp <Icon name="arrow" /></button>
          <a href="/book-a-trial" class="py-3 text-sm font-semibold text-muted underline underline-offset-4 hover:text-fg">Want to book? Use the booking form</a>
        </div>
      </WaForm>
    </div>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>
