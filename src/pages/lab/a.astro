---
// Design direction A, "Poster": light editorial sports poster. Temporary: delete after a direction is chosen.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import site from '../../content/site.json';
import athlete from '../../assets/lab/athlete.jpg';

const facts = [['Where', 'Home · Outdoors · Gym'], ['When', 'Every day, 6 AM – 11 PM'], ['From', 'AED 135 / session']];
const line = 'block overflow-hidden';
---

<Base title="Direction A: Poster" description="Design direction A">
  <div class="bg-paper text-ink">
    <section class="mx-auto max-w-7xl px-4 pt-10 pb-16 sm:px-6 lg:pt-14">
      <div class="grid items-end gap-10 lg:grid-cols-[1fr_22rem]">
        <h1 class="font-black uppercase leading-[0.84] tracking-tight font-stretch-[62%] text-[clamp(4rem,10.5vw,9.5rem)]">
          <span class={line}><span class="block animate-rise">Your trainer</span></span>
          <span class={line}><span class="block animate-rise [animation-delay:.12s]">comes <span class="relative isolate inline-block px-3 before:absolute before:inset-0 before:-z-10 before:-skew-x-[20deg] before:bg-green">to you.</span></span></span>
        </h1>
        <figure>
          <Image src={athlete} alt="Muscularity Fitness coach on a bodybuilding stage" widths={[400, 667]} sizes="(min-width: 1024px) 22rem, 100vw" class="aspect-[4/5] w-full object-cover grayscale contrast-125" />
          <figcaption class="mt-2 text-xs font-bold uppercase tracking-widest text-ink/60">On stage · competitor no. 219</figcaption>
        </figure>
      </div>

      <p class="mt-10 max-w-xl text-xl leading-relaxed">One-to-one personal training in {site.city}, at your home, outdoors or in the gym. Your first session is free.</p>

      <dl class="mt-12 grid border-t-2 border-ink sm:grid-cols-3">
        {facts.map(([k, v]) => (
          <div class="border-b border-ink/15 py-5 sm:border-r sm:border-b-0 sm:px-5 sm:first:pl-0 sm:last:border-r-0">
            <dt class="text-xs font-bold uppercase tracking-widest text-ink/60">{k}</dt>
            <dd class="mt-1 text-2xl font-extrabold uppercase font-stretch-[75%]">{v}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-10 flex flex-wrap items-center gap-8">
        <a href="/book-a-trial" class="bg-ink px-8 py-4 font-bold uppercase text-paper transition hover:bg-green hover:text-ink">Book a free trial →</a>
        <a href={site.whatsappUrl} class="font-bold uppercase underline decoration-green decoration-4 underline-offset-8">or WhatsApp us</a>
      </div>
    </section>

    <div class="overflow-hidden bg-ink py-4 text-paper" aria-hidden="true">
      <div class="flex w-max animate-marquee gap-8 text-4xl font-black uppercase font-stretch-[62%]">
        {[...site.services, ...site.services].map((s) => <span>{s.name} <span class="text-green">/</span></span>)}
      </div>
    </div>

    <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <h2 class="text-sm font-bold uppercase tracking-widest text-ink/60">Six ways to train</h2>
      <ul class="mt-6 border-t-2 border-ink">
        {site.services.map((s) => (
          <li class="border-b border-ink/15">
            <a href={`/services/${s.slug}`} class="group flex items-center justify-between gap-6 px-2 py-4 transition-colors duration-300 hover:bg-green">
              <span class="text-[clamp(2rem,6vw,4.5rem)] leading-none font-black uppercase font-stretch-[62%] transition-transform duration-500 ease-out-expo group-hover:translate-x-4">{s.name}</span>
              <span class="text-3xl transition-transform duration-500 group-hover:-rotate-45">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <nav class="fixed right-4 bottom-20 z-50 flex bg-ink p-1 text-xs font-bold ring-1 ring-line md:bottom-4">
    {['a', 'b', 'c'].map((d) => <a href={`/lab/${d}`} aria-current={d === 'a' ? 'page' : undefined} class="px-3 py-2 aria-[current=page]:bg-green aria-[current=page]:text-ink">{d.toUpperCase()}</a>)}
  </nav>
</Base>
