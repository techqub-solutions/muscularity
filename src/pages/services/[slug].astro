---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import site from '../../content/site.json';
import bannerPhoto from '../../assets/photos/trainer-client.jpg';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const s = service.data;
const t = site.testimonials[(s.order - 1) % site.testimonials.length];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${s.name} personal training`,
  description: s.description,
  areaServed: site.city,
  provider: { '@id': `${site.url}/#business` }, // the LocalBusiness in Base.astro
  offers: { '@type': 'Offer', price: site.price.amount, priceCurrency: 'AED', description: `Per session. ${site.price.note}` },
};
---

<Base title={s.seoTitle} description={s.description}>
  <PageHero title={s.name} titleEnd={`in ${site.city}`} eyebrow="One-to-one personal training" intro={s.tagline} image={s.image} crumbs={[['Services', '/#services'], [s.name, `/services/${service.id}`]]}>
    <!-- Phones and tablets: the price up here (the price card is beside the text only from lg) -->
    <p class="mt-6 animate-fade-up text-fg/85 [animation-delay:280ms] lg:hidden"><strong class="font-extrabold uppercase font-stretch-[75%] text-xl text-fg">AED {site.price.amount} / session</strong> · may vary by location · first session free</p>
    <div class="mt-8 flex flex-wrap items-center gap-8 lg:mt-10">
      <a href={`/book-a-trial?Service=${encodeURIComponent(s.name)}`} class="btn">Book a free trial <Icon name="arrow" /></a>
      <a href={site.whatsappUrl} class="link">WhatsApp us</a>
    </div>
  </PageHero>

  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-12 sm:gap-16 sm:px-6 sm:py-20 lg:grid-cols-[1fr_22rem] lg:py-28">
    <div>
      <section class="reveal border-l-4 border-green bg-surface p-6 sm:p-8">
        <h2 class="eyebrow text-green">Who it's for</h2>
        <ul class="mt-5 grid gap-3 text-lg">
          {s.forWho.map((w) => <li class="flex gap-3"><Icon name="check" class="mt-1 size-5 shrink-0 text-green" />{w}</li>)}
        </ul>
      </section>
      <div class="prose mt-14 text-fg/80"><Content /></div>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="border border-line bg-surface p-6">
        <p class="eyebrow text-muted">Price</p>
        <p class="mt-1 font-extrabold uppercase font-stretch-[70%]"><span class="text-2xl">AED</span> <span class="text-6xl">{site.price.amount}</span> <span class="text-lg text-muted">/ session</span></p>
        <p class="mt-2 text-sm text-muted">{site.price.note}</p>
        <ul class="mt-6 grid gap-3 border-t border-line pt-6 text-fg/85">
          <li class="flex items-center gap-3"><Icon name="pin" class="size-5 text-green" />{site.places.join(' · ')}</li>
          <li class="flex items-center gap-3"><Icon name="clock" class="size-5 text-green" />{site.hoursText}</li>
          <li class="flex items-center gap-3"><Icon name="check" class="size-5 text-green" />First session free</li>
        </ul>
        <a href={`/book-a-trial?Service=${encodeURIComponent(s.name)}`} class="btn mt-8 w-full">Book a free trial</a>
      </div>
      <figure class="mt-3 border-l-4 border-green bg-surface p-6">
        <blockquote class="display text-3xl">“{t.highlight}”</blockquote>
        <figcaption class="eyebrow mt-3 text-muted">{t.name}, client</figcaption>
      </figure>
    </aside>
  </div>

  <!-- overflow-clip, not hidden: hidden would make it a scroll container and freeze the heading's scroll animation -->
  <section class="relative isolate overflow-clip">
    <Image src={bannerPhoto} alt="" widths={[640, 1280, 1920]} sizes="100vw" class="absolute inset-0 -z-10 size-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-ink/85 sm:bg-transparent sm:bg-linear-to-r sm:from-ink sm:via-ink/85 sm:to-ink/30"></div>
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:py-28">
      <p class="eyebrow text-green">First session free</p>
      <h2 class="display rise-lines mt-4 max-w-3xl text-[clamp(2.75rem,6vw,5.5rem)]"><span><span>Try {s.name} on us</span></span></h2>
      <p class="mt-5 max-w-xl text-lg text-fg/85">One free session at your home, outdoors or in the gym. Then book more sessions if you want to continue.</p>
      <div class="mt-8 flex flex-wrap items-center gap-8">
        <a href={`/book-a-trial?Service=${encodeURIComponent(s.name)}`} class="btn">Book my free session <Icon name="arrow" /></a>
        <a href={site.whatsappUrl} class="link">WhatsApp us</a>
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:gap-12 sm:px-6 sm:py-20 lg:grid-cols-[1fr_1.6fr] lg:py-28">
      <h2 class="display rise-lines text-[clamp(2.5rem,5vw,4.5rem)]"><span><span>{s.name}:</span></span> <span><span style="--i:1">your questions</span></span></h2>
      <Faq items={s.faqs} />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 sm:pb-24">
    <h2 class="display rise-lines text-[clamp(2.5rem,5vw,4.5rem)]"><span><span>Pair it with</span></span></h2>
    <div class="mt-8 sm:mt-10"><ServiceGrid exclude={service.id} limit={3} /></div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>
