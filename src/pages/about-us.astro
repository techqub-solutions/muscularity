---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import site from '../content/site.json';
import photo from '../assets/photos/trainer-gym.jpg';
import founder from '../assets/photos/founder.jpg';

const why = [
  ['Led by experience', `Founded by ${site.founder.name}, with ${site.founder.years} years in fitness across Cross Fit, bodybuilding, functional training and strength.`],
  ['Six disciplines', 'Cross Fit, bodybuilding, general fitness, flexibility and mobility, functional training, and strength and conditioning.'],
  ['Built around you', 'Every workout is tailored to your level and goals, whether you are a beginner or an advanced athlete.'],
  ['Results you can see', 'Personal plans, continuous progress tracking and a focus on your overall health.'],
];
const how = [
  ['Personal assessment', 'Before you start, we learn your fitness level, goals and any limitations.'],
  ['Tailored programme', 'Your plan targets your goal: strength, endurance, agility or all three.'],
  ['Expert coaching', 'Clear instruction and correct technique in every session, to prevent injury.'],
  ['Holistic approach', 'Functional work, flexibility and mobility for a stronger body and mind.'],
  ['Real support', 'Encouragement and accountability that keep you going.'],
  ['Progress tracking', 'Regular check-ins and plan adjustments, so you keep moving forward.'],
];
const values = [
  ['Commitment to excellence', 'The highest quality coaching, tailored to each client.'],
  ['Community', 'A welcoming environment where everyone feels valued and encouraged.'],
  ['Integrity', 'Honest, open communication, and we deliver on our promises.'],
  ['Continuous improvement', 'We keep learning the latest training research and techniques.'],
  ['Health and wellness', 'Fitness is a balanced lifestyle: strong body, strong mind.'],
];
const h2 = 'display text-[clamp(2.75rem,6vw,5rem)]';
---

<Base title="About Muscularity Fitness" description="Muscularity Fitness is a personal training company in Abu Dhabi, founded in 2024. Six disciplines, one-to-one coaching, at your home, outdoors or in the gym.">
  <PageHero title="About us" image={photo} crumbs={[['About us', '/about-us']]} intro="We transform lives through fitness: one-to-one coaching that builds a strong body and a positive mindset, for every level." />

  <section class="mx-auto grid max-w-7xl gap-16 px-4 py-24 sm:px-6 lg:grid-cols-2 lg:py-32">
    <div>
      <h2 class={h2}>Why Muscularity</h2>
      <p class="mt-6 max-w-lg text-lg text-fg/75">Fitness is a journey, and we guide you every step of the way, pushing past your limits toward results that last.</p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2">
      {why.map(([title, text]) => (
        <li class="reveal border-t-4 border-green bg-surface p-6">
          <h3 class="text-xl font-extrabold uppercase font-stretch-[75%]">{title}</h3>
          <p class="mt-2 text-fg/70">{text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-paper text-ink">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:py-32">
      <p class="eyebrow text-ink/60">How we work</p>
      <h2 class={`${h2} mt-4`}>Six steps. One plan: yours.</h2>
      <ol class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {how.map(([title, text], i) => (
          <li class="reveal border-t-2 border-ink pt-5">
            <span class="display text-5xl text-ink/25">0{i + 1}</span>
            <h3 class="mt-3 text-2xl font-extrabold uppercase font-stretch-[75%]">{title}</h3>
            <p class="mt-2 text-ink/70">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-12 px-4 py-24 sm:px-6 lg:grid-cols-2 lg:py-32">
    <div class="reveal border-l-4 border-green pl-6">
      <p class="eyebrow text-green">Mission</p>
      <p class="mt-4 text-2xl leading-snug font-bold">To inspire and empower people to lead healthier, more active lives through high-quality programmes, personal coaching and a supportive community.</p>
    </div>
    <div class="reveal border-l-4 border-line pl-6">
      <p class="eyebrow text-muted">Vision</p>
      <p class="mt-4 text-2xl leading-snug font-bold">To set a new standard in fitness training, with a holistic approach to physical strength, mental resilience and long-term wellbeing.</p>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:py-32">
      <h2 class={h2}>What we stand for</h2>
      <ul class="mt-12 divide-y divide-line border-y border-line">
        {values.map(([title, text]) => (
          <li class="grid gap-2 py-6 md:grid-cols-[1fr_1.4fr] md:items-baseline">
            <h3 class="display text-3xl sm:text-4xl">{title}</h3>
            <p class="text-lg text-fg/70">{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto flex max-w-7xl flex-col items-center gap-10 px-4 py-20 sm:px-6 md:flex-row">
      <Image src={founder} alt={`${site.founder.name}, founder`} widths={[240, 480]} sizes="12rem" class="size-48 shrink-0 object-cover [clip-path:polygon(12%_0,100%_0,88%_100%,0_100%)]" />
      <div>
        <p class="eyebrow text-green">Founder</p>
        <h2 class="display mt-3 text-5xl">{site.founder.name}</h2>
        <p class="mt-3 max-w-xl text-lg text-fg/75">{site.founder.years} years in fitness. Founded {site.name} in {site.founder.founded}.</p>
        <a href="/about-founder" class="link mt-6 inline-block">Read his story</a>
      </div>
    </div>
  </section>
</Base>
