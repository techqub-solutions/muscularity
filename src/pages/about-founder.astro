---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';
import photo from '../assets/photos/founder.jpg';

const f = site.founder;
const disciplines = ['Cross Fit', 'Body Building', 'Functional Training', 'Strength Conditioning'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: f.name,
  jobTitle: f.role,
  image: new URL(photo.src, Astro.site).href,
  worksFor: { '@type': 'LocalBusiness', name: site.name, url: site.url },
};
---

<Base title={`${f.name}, Personal Trainer`} description={`Meet ${f.name}, founder of Muscularity Fitness in Abu Dhabi: ${f.years} years in fitness across Cross Fit, bodybuilding, functional training and strength.`}>
  <section class="border-b border-line">
    <div class="mx-auto grid max-w-7xl items-center gap-16 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_1.1fr] lg:py-24">
      <div class="relative mx-auto w-full max-w-md lg:order-last">
        <div class="absolute inset-0 translate-x-5 translate-y-5 bg-green [clip-path:polygon(12%_0,100%_0,88%_100%,0_100%)]"></div>
        <Image src={photo} alt={`${f.name} on a bodybuilding stage`} widths={[480, 667]} sizes="(min-width: 1024px) 28rem, 90vw" loading="eager" class="relative aspect-[4/5] w-full object-cover [clip-path:polygon(12%_0,100%_0,88%_100%,0_100%)]" />
      </div>
      <div>
        <nav aria-label="Breadcrumb" class="eyebrow text-muted"><a href="/" class="hover:text-fg">Home</a> <span class="text-green">/</span> <a href="/about-us" class="hover:text-fg">About</a> <span class="text-green">/</span> <span class="text-fg">Founder</span></nav>
        <p class="eyebrow mt-14 text-green">{f.role}, {site.name}</p>
        <h1 class="display mt-4 text-[clamp(3.5rem,9vw,8rem)]">{f.name}</h1>
        <dl class="mt-10 grid max-w-md grid-cols-2 gap-6 border-t border-line pt-6">
          <div><dt class="eyebrow text-muted">In fitness</dt><dd class="display mt-2 text-6xl text-green">{f.years} yrs</dd></div>
          <div><dt class="eyebrow text-muted">Founded</dt><dd class="display mt-2 text-6xl">{f.founded}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <div class="mx-auto grid max-w-7xl gap-16 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_20rem] lg:py-28">
    <div class="prose text-fg/80">
      <p>{f.name} has spent more than {f.years.replace('+', '')} years in the fitness industry, dedicating his career to changing lives through health and training. What began as a love of fitness became a lifelong commitment to guiding others toward their goals.</p>
      <p>With a deep understanding of how the body moves, how to fuel it and how to train it, he works across Cross Fit, bodybuilding, functional training and strength conditioning.</p>
      <h2>Why he started Muscularity Fitness</h2>
      <p>In {f.founded} he founded {site.name}, built on hard work, innovation and personal training. The goal was simple: a place where everyone, from beginners to advanced athletes, can train, grow and excel.</p>
      <p>Every client gets a personal plan that combines strength, flexibility, endurance and mobility work, designed for results that last.</p>
      <h2>How he coaches</h2>
      <p>From preparing athletes for competition to guiding weight-loss transformations and improving everyday health, his approach starts with understanding each person's needs. He keeps learning the latest training methods, so his clients always get up-to-date programmes.</p>
    </div>
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="border border-line bg-surface p-6">
        <h2 class="eyebrow text-muted">Disciplines</h2>
        <ul class="mt-4 grid gap-3 text-lg font-bold">
          {disciplines.map((d) => <li class="flex items-center gap-3"><Icon name="check" class="size-5 text-green" />{d}</li>)}
        </ul>
        <a href="/book-a-trial" class="btn mt-8 w-full">Train with us</a>
      </div>
    </aside>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>
