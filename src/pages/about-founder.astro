---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';
import photo from '../assets/photos/founder.jpg';

const f = site.founder;
const disciplines = ['Cross Fit', 'Body Building', 'Functional Training', 'Strength Conditioning'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: f.name,
  jobTitle: f.role,
  image: new URL(photo.src, Astro.site).href,
  worksFor: { '@id': `${site.url}/#business` }, // the LocalBusiness in Base.astro
};
const crumbs = [['Home', '/'], ['About', '/about-us'], ['Founder', '/about-founder']];
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map(([name, href], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(href, Astro.site).href })),
};
---

<Base title={`${f.name}, Personal Trainer`} description={`Meet ${f.name}, founder of Muscularity Fitness in Abu Dhabi: ${f.years} years in fitness across Cross Fit, bodybuilding, functional training and strength.`}>
  <!-- Phones: breadcrumbs and name first, then the photo (like every other page); photo on the right from lg -->
  <section class="border-b border-line">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 pt-6 pb-12 sm:px-6 sm:py-16 lg:grid-cols-[1fr_1.1fr] lg:gap-16 lg:py-24">
      <div>
        <nav aria-label="Breadcrumb" class="eyebrow animate-fade-up text-muted">
          {crumbs.map(([name, href], i) => (i < crumbs.length - 1 ? <><a href={href} class="-my-3.5 inline-block py-3.5 hover:text-fg">{name}</a> <span class="text-green">/</span> </> : <span aria-current="page" class="text-fg">{name}</span>))}
        </nav>
        <p class="eyebrow mt-8 animate-fade-up text-green [animation-delay:80ms] sm:mt-14">{f.role}, {site.name}</p>
        <h1 class="display mt-4 animate-fade-up text-[clamp(3.5rem,9vw,8rem)] [animation-delay:150ms]">{f.name}</h1>
        <dl class="mt-8 grid max-w-md animate-fade-up grid-cols-2 gap-6 border-t border-line pt-6 [animation-delay:220ms] sm:mt-10">
          <div><dt class="eyebrow text-muted">In fitness</dt><dd class="display mt-2 text-5xl text-green sm:text-6xl">{f.years} yrs</dd></div>
          <div><dt class="eyebrow text-muted">Founded</dt><dd class="display mt-2 text-5xl sm:text-6xl">{f.founded}</dd></div>
        </dl>
      </div>
      <div class="relative mx-auto w-full max-w-[18rem] sm:max-w-md">
        <div class="absolute inset-0 translate-x-3 translate-y-3 bg-green sm:translate-x-5 sm:translate-y-5 [clip-path:polygon(12%_0,100%_0,88%_100%,0_100%)]"></div>
        <div class="slash-load relative overflow-hidden [clip-path:polygon(12%_0,100%_0,88%_100%,0_100%)]">
          <Image src={photo} alt={`${f.name} on a bodybuilding stage`} widths={[480, 667]} sizes="(min-width: 1024px) 28rem, (min-width: 640px) 28rem, 18rem" loading="eager" class="aspect-[4/5] w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-12 sm:gap-16 sm:px-6 sm:py-20 lg:grid-cols-[1fr_20rem] lg:py-28">
    <div class="prose text-fg/80">
      <p>{f.name} has spent more than {f.years.replace('+', '')} years in the fitness industry, dedicating his career to changing lives through health and training. What began as a love of fitness became a lifelong commitment to guiding others toward their goals.</p>
      <p>With a deep understanding of how the body moves, how to fuel it and how to train it, he works across Cross Fit, bodybuilding, functional training and strength conditioning.</p>
      <h2>Why he started Muscularity Fitness</h2>
      <p>In {f.founded} he founded {site.name}, built on hard work, innovation and personal training. The goal was simple: a place where everyone, from beginners to advanced athletes, can train, grow and excel.</p>
      <p>Every client gets a personal plan that combines strength, flexibility, endurance and mobility work, designed for results that last.</p>
      <h2>How he coaches</h2>
      <p>From preparing athletes for competition to guiding weight-loss transformations and improving everyday health, his approach starts with understanding each person's needs. He keeps learning the latest training methods, so his clients always get up-to-date programmes.</p>
    </div>
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="border border-line bg-surface p-6">
        <h2 class="eyebrow text-muted">Disciplines</h2>
        <ul class="mt-4 grid gap-3 text-lg font-bold">
          {disciplines.map((d) => <li class="flex items-center gap-3"><Icon name="check" class="size-5 text-green" />{d}</li>)}
        </ul>
        <a href="/book-a-trial" class="btn mt-8 w-full">Train with us</a>
      </div>
    </aside>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
</Base>
