---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import ClientVideos from '../components/ClientVideos.astro';
import SwipeHint from '../components/SwipeHint.astro';
import Faq from '../components/Faq.astro';
import site from '../content/site.json';
import cutout from '../assets/photos/hero-cutout.png';
import photo from '../assets/photos/trainer-client.jpg';
import founder from '../assets/photos/founder.jpg';
import photoGym from '../assets/photos/trainer-gym.jpg';
import photoFitness from '../assets/photos/fitness.jpg';
import photoSprint from '../assets/photos/sprint.jpg';
import photoHome from '../assets/photos/flexibility.jpg';

const posts = await getCollection('blog');
const { founder: f } = site;
const quote = site.testimonials[2]; // shown beside the hero photo on desktop
const proof = [0, 1, 3].map((i) => site.testimonials[i]); // the strip under the hero: the others
const price = `AED ${site.price.amount} / session`; // one price for every service (varies by location)
const hours = site.hoursText.replace('Every day', 'every day');
// Never wrap inside, e.g. "6 AM – 11 PM": no-break spaces, and a word joiner (U+2060) because browsers may still break after a dash
const keep = (s: string) => s.replaceAll(' ', ' ').replaceAll('–', '–⁠');
const openHours = keep(site.hoursText.replace('Every day, ', ''));
const facts = [['Where', site.places.join(' · ')], ['When', `Daily, ${openHours}`], ['Price', `${keep(`AED ${site.price.amount}`)} ${keep('/ session')}`, 'Varies by location']];
const people = [
  ['Busy professionals', 'Train before work from 6 AM or after it until 11 PM, wherever suits your day.', '/services/fitness', 'See the programme', photoGym], // keep in step with site.json hours
  ['Complete beginners', 'Start exactly where you are. We build your strength, fitness and confidence step by step.', '/services/functional-training', 'See the programme', photoFitness],
  ['Athletes and competitors', 'Conditioning for your sport, and full competition prep with posing practice and meal plans.', '/services/strength-training-sports-conditioning', 'See the programme', photoSprint],
  ['Training at home', 'Your space, your privacy, no crowded gym floor. Your trainer comes to you.', '/book-a-trial?Where=Home', 'Book a home session', photoHome],
] as const;
const steps = [
  ['Free trial', 'We assess your fitness and learn your goal, your history and your week.'],
  ['Your plan', 'A programme built for you, not copied from a template.'],
  ['Train', 'One-to-one, at home, outdoors or in the gym. Every session tracked.'],
];
// goal → best-matching service (shown live in the booking card, no JavaScript)
const goals = [
  ['Lose weight', 'fitness', "group-has-[[value='Lose_weight']:checked]:inline"],
  ['Build muscle', 'body-building', "group-has-[[value='Build_muscle']:checked]:inline"],
  ['Get stronger', 'strength-training-sports-conditioning', "group-has-[[value='Get_stronger']:checked]:inline"],
  ['Move better', 'flexibility-and-mobility', "group-has-[[value='Move_better']:checked]:inline"],
];
const serviceName = (slug: string) => site.services.find((s) => s.slug === slug)?.name;
const stats = [
  [parseInt(f.years), '+', 'Years in fitness: our founder'],
  [site.services.length, '', 'Training disciplines'],
  [site.places.length, '', 'Places to train'],
  [7, '', `Days a week, ${openHours}`],
] as const;
const chip = 'cursor-pointer border border-ink/25 px-4 py-2.5 font-semibold transition hover:border-ink has-checked:border-ink has-checked:bg-ink has-checked:text-paper has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-green';
const label = 'eyebrow text-ink/60';
const included = ['One-to-one with your own trainer', 'Any of our six disciplines', 'At your home, outdoors or in the gym', site.hoursText];
const h2 = 'display text-[clamp(3rem,7vw,6rem)]';
// Homepage only: tells Google the site name to show in results
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, publisher: { '@id': `${site.url}/#business` } };
---

<Base title="Personal Trainer Abu Dhabi" description={`One-to-one personal training in ${site.city} at home, outdoors or in the gym. ${price} (varies by location), ${hours}. First session free.`}>
  <!-- Hero: text left; on the right the "out of bounds" photo (see CLAUDE.md).
       Phones: text, then the photo (so it is in the first screen, even at 667 px tall), then the facts in one row.
       The WhatsApp link is left out on phones: the bottom bar has it. -->
  <section class="relative isolate overflow-hidden">
    <div class="mx-auto grid max-w-7xl gap-4 px-4 pt-6 sm:gap-6 sm:px-6 sm:pt-8 lg:min-h-[46rem] lg:grid-cols-[1.1fr_1fr] lg:grid-rows-[1fr_auto] lg:gap-0 lg:pt-0">
      <div class="relative z-10 lg:self-end lg:pt-16">
        <h1>
          <span class="eyebrow block text-green">Personal trainer in {site.city}</span>{' '}
          <span class="display mt-3 block text-[clamp(3rem,15vw,6.75rem)] leading-[0.9] sm:mt-5">
            <span class="block overflow-hidden"><span class="block animate-rise">Your trainer.</span></span>{' '}
            <span class="block overflow-hidden"><span class="block animate-rise text-green [animation-delay:.1s]">Your place.</span></span>{' '}
            <span class="block overflow-hidden"><span class="block animate-rise [animation-delay:.2s]">Your pace.</span></span>
          </span>
        </h1>
        <p class="mt-4 max-w-md text-base text-fg/85 sm:mt-6 sm:text-lg">One-to-one coaching at your home, outdoors or in the gym, {hours}. Your first session is free.</p>
        <div class="mt-6 flex flex-col gap-4 sm:mt-10 sm:flex-row sm:flex-wrap sm:items-center sm:gap-8">
          <a href="/book-a-trial" class="btn">Book a free trial <Icon name="arrow" /></a>
          <a href={site.whatsappUrl} class="link hidden sm:inline">WhatsApp us</a>
        </div>
      </div>

      <!-- Out-of-bounds: the photo sits in a slanted frame; the same people, cut out, sit exactly on top and step out of the frame -->
      <div class="relative -mx-4 aspect-[4/3] animate-pop sm:-mx-6 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mx-0 lg:-mr-[max(1.5rem,calc((100vw_-_80rem)/2_+_1.5rem))] lg:self-end">
        <div class="absolute inset-0 -translate-x-2 bg-green [clip-path:polygon(34%_0,100%_0,100%_100%,14%_100%)]"></div>
        <Image src={photo} alt="" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" class="absolute inset-0 size-full object-cover object-[30%_50%] [clip-path:polygon(34%_0,100%_0,100%_100%,14%_100%)]" />
        <Image src={cutout} alt="A personal trainer coaching a client through a core exercise" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 size-full object-cover object-[30%_50%]" />
        <figure class="absolute right-4 bottom-full mb-6 hidden max-w-[17rem] border-l-4 border-green bg-fg p-5 text-ink shadow-2xl lg:block">
          <blockquote class="text-lg leading-snug font-semibold">“{quote.text.split(/(?<=[.!?])\s/)[0]}”</blockquote>
          <figcaption class="eyebrow mt-3 text-ink/60">{quote.name}</figcaption>
        </figure>
      </div>

      <dl class="relative z-10 grid max-w-2xl grid-cols-2 gap-x-4 gap-y-4 border-t border-line pt-4 pb-8 sm:grid-cols-[repeat(3,auto)] sm:justify-start sm:gap-x-10 sm:pt-6 sm:pb-10 lg:mt-14 lg:self-start lg:pb-16">
        {facts.map(([k, v, note], i) => (
          <div class:list={[i === 0 && 'col-span-2 sm:col-span-1']}>
            <dt class="eyebrow text-muted">{k}</dt>
            <dd class="mt-1 text-base leading-tight font-extrabold uppercase font-stretch-[75%] sm:text-xl">{v}{note && <span class="mt-1 block text-xs font-semibold normal-case text-muted font-stretch-normal">{note}</span>}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Proof: real client words straight under the hero (competitors put reviews here, not at the bottom) -->
  <section class="border-y border-line bg-surface" aria-label="What clients say">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      <div class="flex items-center justify-between gap-4">
        <h2 class="eyebrow text-muted">What clients say</h2>
        <a href="#reviews" class="eyebrow -my-3.5 flex items-center gap-2 py-3.5 text-green hover:text-fg">All reviews <Icon name="arrow" class="size-4" /></a>
      </div>
      <SwipeHint text={`${proof.length} reviews`} class="mt-2" />
      <ul class="swipe mt-4 md:grid-cols-3">
        {proof.map((t) => (
          <li class="flex flex-col justify-between gap-3 border-l-4 border-green bg-ink p-5">
            <p class="display text-2xl">“{t.highlight}”</p>
            <p class="eyebrow text-muted">{t.name}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Marquee -->
  <div class="overflow-hidden bg-green py-4 text-ink" aria-hidden="true">
    <div class="flex w-max animate-marquee text-3xl font-black uppercase font-stretch-[62%] sm:text-4xl">
      {[...site.services, ...site.services].map((s, i) => (
        <span class:list={['pr-10', i % 2 && 'text-transparent [-webkit-text-stroke:1.5px_var(--color-ink)]']}>{s.name} <span class="pl-8 text-ink">/</span></span>
      ))}
    </div>
  </div>

  <!-- How it works + quick booking. Phones: heading, then the card, then the steps -->
  <section class="bg-paper text-ink">
    <div class="mx-auto grid max-w-7xl gap-x-16 gap-y-10 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_26rem] lg:gap-y-12 lg:py-32">
      <div>
        <p class={label}>How it works</p>
        <h2 class={`${h2} mt-4`}>Start with a free session</h2>
      </div>

      <form action="/book-a-trial" class="group reveal self-start border-2 border-ink bg-paper shadow-[10px_10px_0_var(--color-green)] lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <p class="flex items-center justify-between border-b-2 border-ink px-5 py-3"><span class={label}>Session 01</span><span class="bg-green px-2 py-1 text-xs font-bold uppercase">Free trial</span></p>
        <fieldset class="border-b border-ink/15 p-5">
          <legend class={`float-left mb-3 w-full ${label}`}>Where</legend>
          <div class="clear-both flex flex-wrap gap-2">
            {site.places.map((p, i) => <label class={chip}><input type="radio" name="Where" value={p} checked={i === 0} class="sr-only" />{p}</label>)}
          </div>
        </fieldset>
        <fieldset class="border-b border-ink/15 p-5">
          <legend class={`float-left mb-3 w-full ${label}`}>Your goal</legend>
          <div class="clear-both flex flex-wrap gap-2">
            {goals.map(([g], i) => <label class={chip}><input type="radio" name="Goal" value={g} checked={i === 0} class="sr-only" />{g}</label>)}
          </div>
          <p class="mt-4 text-sm text-ink/70" aria-live="polite">Best match:{' '}
            {goals.map(([, slug, show]) => <a href={`/services/${slug}`} class={`hidden font-bold text-ink underline decoration-green decoration-2 underline-offset-4 ${show}`}>{serviceName(slug)}</a>)}
          </p>
        </fieldset>
        <p class="p-5 text-sm text-ink/70">{site.hoursText}. We confirm on WhatsApp.</p>
        <button class="flex w-full items-center justify-between bg-ink px-5 py-4 font-bold uppercase text-paper transition hover:bg-green hover:text-ink">Book my free session <Icon name="arrow" /></button>
      </form>

      <ol class="grid gap-8">
        {steps.map(([title, text], i) => (
          <li class="reveal grid grid-cols-[4.5rem_1fr] gap-4 border-t-2 border-ink pt-5">
            <span class="display text-6xl text-ink/25" aria-hidden="true">0{i + 1}</span>
            <div>
              <h3 class="text-2xl font-extrabold uppercase font-stretch-[75%]">{title}</h3>
              <p class="mt-1 text-lg text-ink/70">{text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Services -->
  <section id="services">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:py-32">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class={h2}>Six ways<br />to train</h2>
        <p class="max-w-sm text-lg text-fg/70">Every programme is one-to-one and built around your goal, your level and your week.</p>
      </div>
      <div class="mt-8 md:mt-12"><ServiceGrid /></div>
    </div>
  </section>

  <!-- Who we train -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:py-32">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class={h2}>Built for<br />your life</h2>
        <p class="max-w-sm text-lg text-fg/70">However busy, new or competitive you are, your programme starts where you are.</p>
      </div>
      <SwipeHint text={`${people.length} profiles`} class="mt-8 mb-4" />
      <ul class="swipe reveal md:mt-12 md:grid-cols-2">
        {people.map(([title, text, href, cta, img]) => (
          <li>
            <a href={href} class="group relative isolate flex min-h-96 flex-col justify-end overflow-hidden p-6 sm:p-8">
              <Image src={img} alt="" widths={[480, 960]} sizes="(min-width: 768px) 45vw, 80vw" class="absolute inset-0 -z-10 size-full object-cover transition duration-700 ease-out-expo group-hover:scale-105" />
              <div class="absolute inset-0 -z-10 bg-linear-to-t from-ink via-ink/70 to-ink/25"></div>
              <p class="eyebrow text-green">For</p>
              <h3 class="display mt-2 text-[clamp(1.75rem,8.5vw,3rem)]">{title}</h3>
              <p class="mt-3 max-w-md text-lg text-fg/85">{text}</p>
              <span class="eyebrow mt-6 flex items-center gap-2 text-green">{cta} <Icon name="arrow" class="size-4 transition duration-300 group-hover:translate-x-1" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Price: one price per session -->
  <section id="packages" class="border-t border-line">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:py-32">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class={h2}>One clear price.<br /><span class="text-muted">Per session.</span></h2>
        <p class="max-w-sm text-lg text-fg/70">Every session is one-to-one coaching at your home, outdoors or in the gym.</p>
      </div>
      <div class="mt-14 grid gap-3 lg:grid-cols-[1fr_1.2fr]">
        <div class="reveal flex min-h-64 flex-col justify-between gap-6 bg-green p-6 pt-14 text-ink [clip-path:polygon(0_10%,100%_0,100%_100%,0_100%)] sm:p-8 sm:pt-16">
          <p class="eyebrow opacity-75">Personal training</p>
          <p class="font-extrabold uppercase font-stretch-[70%]"><span class="text-2xl">AED</span> <span class="text-7xl sm:text-8xl">{site.price.amount}</span> <span class="text-lg opacity-75">/ session</span></p>
          <p class="font-semibold">{site.price.note}</p>
        </div>
        <ul class="reveal grid content-center gap-4 bg-surface p-6 text-lg sm:p-8">
          {included.map((item) => <li class="flex gap-3"><Icon name="check" class="mt-1 size-5 shrink-0 text-green" />{item}</li>)}
          <li class="flex gap-3 font-bold"><Icon name="check" class="mt-1 size-5 shrink-0 text-green" />Your first session is free</li>
        </ul>
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-between gap-6 border-t border-line pt-8">
        <p class="text-lg text-fg/80">Want the price for your area? <a href={site.whatsappUrl} class="underline decoration-green decoration-2 underline-offset-4 hover:text-green">Ask us on WhatsApp</a>.</p>
        <a href="/book-a-trial" class="btn">Start with a free trial</a>
      </div>
    </div>
  </section>

  <!-- Numbers banner -->
  <section class="bg-green text-ink" aria-label="Muscularity Fitness in numbers">
    <dl class="mx-auto grid max-w-7xl grid-cols-2 lg:grid-cols-4">
      {stats.map(([n, suffix, text]) => (
        <div class="flex flex-col-reverse gap-2 border-ink/20 px-4 py-6 odd:border-r sm:px-6 sm:py-10 lg:border-r lg:last:border-r-0">
          <dt class="text-sm font-bold uppercase tracking-wide">{text}</dt>
          <dd class="display text-6xl sm:text-8xl"><span class="count" style={`--n:${n}`} aria-hidden="true"></span><span class="sr-only">{n}</span>{suffix}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Founder -->
  <section class="bg-surface">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 sm:gap-16 lg:grid-cols-2 lg:py-32">
      <div class="reveal relative mx-auto w-full max-w-[18rem] sm:max-w-md">
        <div class="absolute inset-0 translate-x-3 translate-y-3 bg-green sm:translate-x-5 sm:translate-y-5 [clip-path:polygon(12%_0,100%_0,88%_100%,0_100%)]"></div>
        <Image src={founder} alt={`${f.name}, founder of ${site.name}, on a bodybuilding stage`} widths={[480, 667]} sizes="(min-width: 1024px) 28rem, 90vw" class="relative aspect-[4/5] w-full object-cover [clip-path:polygon(12%_0,100%_0,88%_100%,0_100%)]" />
      </div>
      <div>
        <p class="eyebrow text-green">Meet the founder</p>
        <h2 class={`${h2} mt-4`}>{f.name}</h2>
        <p class="mt-6 max-w-lg text-lg text-fg/80">{f.years} years in fitness, across bodybuilding, Cross Fit, functional training and strength conditioning. In {f.founded} he founded {site.name} so every client gets a plan built around them.</p>
        <blockquote class="mt-8 max-w-lg border-l-4 border-green pl-5 text-lg text-fg/90">“{site.testimonials[3].text.split(/(?<=[.!?])\s/)[0]}”<footer class="eyebrow mt-2 text-muted">{site.testimonials[3].name}</footer></blockquote>
        <a href="/about-founder" class="link mt-10 inline-block">Read his story</a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <!-- Long reviews show 4 lines + "Read more", so one long review doesn't make every card tall -->
  <section id="reviews" class="py-16 sm:py-20 lg:py-32">
    <div class="mx-auto flex max-w-7xl flex-wrap items-end justify-between gap-x-6 gap-y-4 px-4 sm:px-6">
      <h2 class={h2}>In their words</h2>
      <p class="eyebrow flex items-center gap-2 text-muted">{site.testimonials.length} reviews · Swipe <Icon name="arrow" class="size-4" /></p>
    </div>
    <ul class="mt-8 flex snap-x snap-mandatory scroll-px-(--pad) gap-4 overflow-x-auto px-(--pad) pb-6 [--pad:1rem] sm:[--pad:max(1.5rem,calc((100vw_-_80rem)/2_+_1.5rem))] md:mt-12">
      {site.testimonials.map((t, i) => (
        <li class="group flex w-[85vw] max-w-md shrink-0 snap-start flex-col gap-6 border border-line bg-surface p-6 sm:p-8">
          <p class="display text-[clamp(1.75rem,8.5vw,2.25rem)] text-green">“{t.highlight}”</p>
          {t.text.length > 200 ? (
            <div>
              <blockquote id={`review-${i}`} class="line-clamp-4 text-fg/80 group-data-open:line-clamp-none">{t.text}</blockquote>
              <button type="button" data-more aria-expanded="false" aria-controls={`review-${i}`} class="link mt-3 py-0.5 text-sm"><span class="group-data-open:hidden">Read more</span><span class="hidden group-data-open:inline">Show less</span></button>
            </div>
          ) : <blockquote class="text-fg/80">{t.text}</blockquote>}
          <p class="mt-auto flex items-center gap-3 border-t border-line pt-5">
            <span class="grid size-11 place-items-center rounded-full bg-green text-sm font-black text-ink" aria-hidden="true">{t.name.split(' ').map((w) => w[0]).join('')}</span>
            <span class="eyebrow">{t.name}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Older adults: a short teaser + the client videos; the full text is on /older-adults -->
  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:py-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-green">Training for older adults</p>
          <h2 class={`${h2} mt-4`}>Stay strong.<br />Stay balanced.<br />Stay independent.</h2>
        </div>
        <p class="max-w-sm text-lg text-fg/70">Our specialised training helps older adults improve strength, mobility, balance, and confidence through safe, personalised coaching.</p>
      </div>
      <div class="mt-8 md:mt-12"><ClientVideos /></div>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/book-a-trial" class="btn">Book a free trial <Icon name="arrow" /></a>
        <a href="/older-adults" class="link">How we train older adults</a>
      </div>
    </div>
  </section>

  <!-- BMI -->
  <section class="bg-paper text-ink">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2 lg:gap-14 lg:py-32">
      <div>
        <p class={label}>Free tool</p>
        <h2 class={`${h2} mt-4`}>Check your BMI</h2>
        <p class="mt-6 max-w-md text-lg text-ink/75">Body mass index is a quick first check of your weight for your height. It's a starting point, not a verdict. Your free trial gives you the full picture.</p>
      </div>
      <form id="bmi" class="group grid gap-6 border-2 border-ink p-6 sm:p-8">
        <div class="grid grid-cols-2 gap-4">
          {([
            ['h', 'Height (cm)', 100, 250],
            ['w', 'Weight (kg)', 30, 300],
          ] as const).map(([name, text, min, max]) => (
            <label class="grid gap-2 font-semibold">{text}<input name={name} type="number" inputmode="decimal" min={min} max={max} required class="border-2 border-ink/20 bg-white px-4 py-3 text-lg focus:border-ink focus:outline-none" /></label>
          ))}
        </div>
        <button class="btn justify-self-start">Calculate</button>
        <div>
          <div class="relative h-3 bg-ink/10">
            <div class="absolute inset-y-0 left-[14%] w-[25.6%] bg-green"></div>
            <div class="absolute inset-0 opacity-0 transition duration-700 ease-out-expo group-data-[done]:opacity-100" style="transform: translateX(var(--bmi, 0%))">
              <div class="absolute -top-2 left-0 h-7 w-1.5 -translate-x-1/2 bg-ink"></div>
            </div>
          </div>
          <p class="relative mt-2 h-5 text-sm font-semibold text-ink/60"><span class="absolute left-0">15</span><span class="absolute left-[14%] text-ink">Healthy 18.5 – 24.9</span><span class="absolute right-0">40</span></p>
          <output class="mt-5 block text-2xl font-extrabold"></output>
          <a href="/book-a-trial" class="link mt-4 hidden group-data-[done]:inline-block">Get your plan: book a free trial</a>
        </div>
      </form>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[1fr_1.6fr] lg:gap-12 lg:py-32">
    <div>
      <h2 class="display text-[clamp(3rem,6vw,5.5rem)]">Questions, answered</h2>
      <p class="mt-6 text-lg text-fg/70">Anything else? <a href={site.whatsappUrl} class="underline decoration-green decoration-2 underline-offset-4 hover:text-green">Ask us on WhatsApp</a>.</p>
    </div>
    <Faq items={site.faqs} />
  </section>

  <!-- Blog -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="display text-[clamp(2.5rem,5vw,4.5rem)]">From the blog</h2>
        <a href="/blog" class="link">All articles</a>
      </div>
      <SwipeHint text={`${posts.length} articles`} class="mt-8 mb-4" />
      <ul class="swipe reveal md:mt-12 md:grid-cols-3 md:gap-10">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}`} class="group block">
              <div class="overflow-hidden"><Image src={p.data.image} alt="" widths={[400, 800]} sizes="(min-width: 768px) 30vw, 80vw" class="aspect-[3/2] w-full object-cover transition duration-700 ease-out-expo group-hover:scale-105" /></div>
              <p class="eyebrow mt-5 text-muted">{Math.max(1, Math.round((p.body ?? '').split(/\s+/).length / 200))} min read</p>
              <h3 class="mt-2 text-xl font-bold leading-snug transition-colors group-hover:text-green">{p.data.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#bmi')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const m = Number(data.get('h')) / 100;
    const bmi = Number(data.get('w')) / (m * m);
    const zone = bmi < 18.5 ? 'underweight' : bmi < 25 ? 'in the healthy range' : bmi < 30 ? 'overweight' : 'in the obese range';
    form.style.setProperty('--bmi', `${Math.min(100, Math.max(0, ((bmi - 15) / 25) * 100))}%`);
    const output = form.querySelector('output')!;
    output.textContent = `Your BMI is ${bmi.toFixed(1)}: ${zone}.`;
    form.dataset.done = '';
    // Phones: close the keyboard and bring the result into view
    (document.activeElement as HTMLElement | null)?.blur();
    output.scrollIntoView({ block: 'nearest' });
  });

  // Reviews: "Read more" shows the whole text
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-more]')) {
    button.addEventListener('click', () => button.setAttribute('aria-expanded', String(button.closest('li')!.toggleAttribute('data-open'))));
  }
</script>
