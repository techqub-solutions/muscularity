---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/brand/logo-light.png';
import site from '../content/site.json';

const company = [
  ['About us', '/about-us'],
  ['Our founder', '/about-founder'],
  ['Pricing', '/#packages'],
  ['Careers', '/careers'],
  ['Blog', '/blog'],
  ['Contact', '/contact-us'],
];
const heading = 'eyebrow text-muted';
const path = Astro.url.pathname;
const onBooking = path === '/book-a-trial';
// On a service page the booking links pre-fill that service, like the page's own buttons
const service = site.services.find((s) => path === `/services/${s.slug}`);
const book = service ? `/book-a-trial?Service=${encodeURIComponent(service.name)}` : '/book-a-trial';
---

<!-- Every page ends with the free-trial offer (except the booking page itself) -->
<section class:list={['bg-green text-ink', onBooking && 'hidden']}>
  <div class="mx-auto flex max-w-7xl flex-col gap-10 px-4 py-16 sm:px-6 lg:flex-row lg:items-end lg:justify-between lg:py-20">
    <div>
      <p class="eyebrow">{site.places.join(' · ')} · {site.hoursText}</p>
      <h2 class="display mt-4 text-[clamp(3rem,8vw,7rem)]">Your first session<br />is free.</h2>
    </div>
    <div class="flex flex-wrap items-center gap-8">
      <a href={book} class="btn text-paper! before:bg-ink!">Book a free trial <Icon name="arrow" /></a>
      <a href={site.whatsappUrl} class="relative font-bold uppercase tracking-wide underline decoration-2 underline-offset-8 after:absolute after:-inset-x-1.5 after:-inset-y-2.5">WhatsApp us</a>
    </div>
  </div>
</section>

<footer class="bg-surface">
  <!-- Phones: Services and Company side by side, logo and contact full width -->
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div class="col-span-2 md:col-span-1">
      <Image src={logo} alt={site.name} width={150} densities={[1, 2]} />
      <p class="mt-6 max-w-xs text-fg/70">{site.tagline}</p>
    </div>
    <nav aria-label="Services">
      <h2 class={heading}>Services</h2>
      <ul class="mt-3 grid">
        {site.services.map((s) => <li><a href={`/services/${s.slug}`} class="block py-2.5 text-fg/85 hover:text-green">{s.name}</a></li>)}
        <li><a href="/older-adults" class="block py-2.5 text-fg/85 hover:text-green">Training for older adults</a></li>
      </ul>
    </nav>
    <nav aria-label="Company">
      <h2 class={heading}>Company</h2>
      <ul class="mt-3 grid">
        {company.map(([label, href]) => <li><a href={href} class="block py-2.5 text-fg/85 hover:text-green">{label}</a></li>)}
      </ul>
    </nav>
    <div class="col-span-2 md:col-span-1">
      <h2 class={heading}>Contact</h2>
      <ul class="mt-3 grid text-fg/85">
        <li><a href={site.whatsappUrl} class="flex items-center gap-3 py-2.5 hover:text-green"><Icon name="chat" class="size-5 text-green" />WhatsApp {site.phone}</a></li>
        <li><a href={`tel:${site.tel}`} class="flex items-center gap-3 py-2.5 hover:text-green"><Icon name="phone" class="size-5 text-green" />{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="flex items-center gap-3 py-2.5 hover:text-green"><Icon name="mail" class="size-5 text-green" />{site.email}</a></li>
        <li class="flex items-center gap-3 py-2.5"><Icon name="clock" class="size-5 text-green" />{site.hoursText}</li>
        <li class="flex items-center gap-3 py-2.5"><Icon name="pin" class="size-5 text-green" />{site.city}, UAE</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-4 px-4 py-2 text-sm text-muted sm:px-6 md:pb-28">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <div class="flex gap-6">
        {Object.entries(site.social).map(([label, href]) => <a href={href} target="_blank" rel="noopener" class="py-3 hover:text-fg">{label}</a>)}
        <a href="/privacy-policy" class="py-3 hover:text-fg">Privacy</a>
        <a href="/terms-and-condition" class="py-3 hover:text-fg">Terms</a>
      </div>
    </div>
  </div>

  <a href={site.whatsappUrl} class="btn fixed! right-8 bottom-8 z-40 hidden shadow-2xl after:absolute after:inset-0 after:-z-20 after:-skew-x-18 after:bg-green after:animate-pulse-soft md:inline-flex"><Icon name="chat" />WhatsApp</a>

  <!-- Mobile quick actions (body has bottom padding on mobile so this never covers content; hidden while typing, see global.css).
       Clear of the iPhone home indicator. On the booking page: Call and WhatsApp only. -->
  <nav id="quick-actions" aria-label="Quick actions" class:list={['fixed inset-x-0 bottom-0 z-40 grid border-t border-line bg-ink/95 pb-[env(safe-area-inset-bottom)] text-xs font-bold uppercase backdrop-blur-md md:hidden', onBooking ? 'grid-cols-2' : 'grid-cols-3']}>
    <a href={`tel:${site.tel}`} class="flex flex-col items-center gap-1 py-2.5 active:bg-white/10"><Icon name="phone" />Call</a>
    <a href={site.whatsappUrl} class="flex flex-col items-center gap-1 py-2.5 text-green active:bg-white/10"><Icon name="chat" />WhatsApp</a>
    {!onBooking && <a href={book} class="flex flex-col items-center gap-1 bg-green py-2.5 text-ink active:bg-fg"><Icon name="arrow" />Free trial</a>}
  </nav>
</footer>
