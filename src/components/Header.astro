---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import mark from '../assets/brand/mark-light.png';
import wordmark from '../assets/brand/wordmark-light.png';
import site from '../content/site.json';

const links = [
  ['About', '/about-us'],
  ['Blog', '/blog'],
  ['Careers', '/careers'],
  ['Contact', '/contact-us'],
];
const current = (href: string) => (Astro.url.pathname.startsWith(href) ? 'page' : undefined);
---

<header class="sticky top-0 z-50 border-b border-line bg-ink/80 backdrop-blur-md [view-transition-name:site-header]">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-8 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name} home`}>
      <Image src={mark} alt="" height={36} densities={[1, 2]} loading="eager" />
      <Image src={wordmark} alt="" height={11} densities={[1, 2]} loading="eager" class="hidden sm:block" />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 text-sm font-medium text-muted lg:flex">
      <div class="group relative">
        <a href="/#services" class="flex items-center gap-1 hover:text-fg">Services <Icon name="down" class="size-4" /></a>
        <div class="invisible absolute left-0 top-full w-80 translate-y-2 pt-3 opacity-0 transition duration-300 ease-out-expo group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
          <ul class="rounded-2xl border border-line bg-surface p-2 shadow-2xl">
            {site.services.map((s) => (
              <li><a href={`/services/${s.slug}`} class="block rounded-xl px-4 py-2.5 text-fg/80 hover:bg-white/5 hover:text-fg">{s.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
      {links.map(([label, href]) => (
        <a href={href} aria-current={current(href)} class="hover:text-fg aria-[current=page]:text-fg">{label}</a>
      ))}
    </nav>

    <a href="/book-a-trial" class="btn ml-auto hidden bg-green text-black hover:bg-fg sm:inline-flex">Book a free trial</a>
    <button popovertarget="menu" class="-mr-2 ml-auto p-2 sm:ml-0 lg:hidden" aria-label="Open menu"><Icon name="menu" class="size-6" /></button>
  </div>

  <!-- Mobile menu: native popover, no JavaScript. Never give #menu a display class. -->
  <div id="menu" popover class="m-0 h-dvh max-h-none w-full max-w-none bg-ink p-6 text-fg">
    <div class="flex items-center justify-between">
      <Image src={mark} alt="" height={32} densities={[1, 2]} />
      <button popovertarget="menu" popovertargetaction="hide" class="-mr-2 p-2" aria-label="Close menu"><Icon name="close" class="size-6" /></button>
    </div>
    <nav aria-label="Mobile" class="mt-8 grid text-2xl font-bold">
      {[['Home', '/'], ...links].map(([label, href]) => <a href={href} class="py-2">{label}</a>)}
      <p class="mt-6 mb-2 text-xs font-semibold uppercase tracking-widest text-muted">Services</p>
      {site.services.map((s) => <a href={`/services/${s.slug}`} class="py-1.5 text-base font-medium text-fg/80">{s.name}</a>)}
    </nav>
    <a href="/book-a-trial" class="btn mt-8 w-full bg-green text-black">Book a free trial</a>
  </div>
</header>
