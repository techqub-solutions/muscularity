---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import mark from '../assets/brand/mark-light.png';
import wordmark from '../assets/brand/wordmark-light.png';
import site from '../content/site.json';

const links = [
  ['About', '/about-us'],
  ['Pricing', '/#packages'],
  ['Careers', '/careers'],
  ['Blog', '/blog'],
  ['Contact', '/contact-us'],
];
const menuLinks = [['Home', '/'], ['About', '/about-us'], ['Our founder', '/about-founder'], ...links.slice(1)];
const menuServices = [...site.services.map((s) => [s.name, `/services/${s.slug}`]), ['Training for older adults', '/older-adults']];
const path = Astro.url.pathname;
const current = (href: string) => ((href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined);
---

<header class="sticky top-0 z-50 border-b border-line bg-ink/85 backdrop-blur-md [view-transition-name:site-header]">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-8 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-3 py-1" aria-label={`${site.name} home`}>
      <Image src={mark} alt="" height={36} densities={[1, 2]} loading="eager" />
      <Image src={wordmark} alt="" height={11} densities={[1, 2]} loading="eager" class="hidden min-[360px]:block" />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 text-sm font-semibold uppercase tracking-wide text-fg/70 lg:flex">
      <div class="group relative">
        <a href="/#services" aria-current={current('/services')} class="flex items-center gap-1 hover:text-fg aria-[current=page]:text-green">Services <Icon name="down" class="size-4" /></a>
        <div class="invisible absolute top-full left-0 w-80 translate-y-2 pt-4 opacity-0 transition duration-300 ease-out-expo group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
          <ul class="border border-line bg-surface p-2 normal-case shadow-2xl">
            {site.services.map((s) => (
              <li><a href={`/services/${s.slug}`} class="block px-4 py-2.5 text-base font-medium text-fg/80 hover:bg-white/5 hover:text-green">{s.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
      {links.map(([label, href]) => (
        <a href={href} aria-current={current(href)} class="hover:text-fg aria-[current=page]:text-green">{label}</a>
      ))}
    </nav>

    <a href="/book-a-trial" class="btn ml-auto hidden text-sm sm:inline-flex">Book a free trial</a>
    <button popovertarget="menu" class="-mr-2 ml-auto p-2 sm:ml-0 lg:hidden" aria-label="Open menu"><Icon name="menu" class="size-7" /></button>
  </div>

  <!-- Mobile menu: native popover. Never give #menu a display class. A solid panel slides in from the right and the links
       follow one by one (global.css; off with reduced motion). Book, Call and WhatsApp stay pinned at the bottom. -->
  <div id="menu" popover class="m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto overscroll-contain bg-ink px-4 pt-2.5 pb-0 text-fg sm:px-6 transition-[translate,overlay,display] transition-discrete duration-700 ease-out-expo not-open:translate-x-full starting:open:translate-x-full">
    <div class="flex items-center justify-between">
      <span class="flex items-center gap-3 py-1">
        <Image src={mark} alt="" height={36} densities={[1, 2]} loading="eager" />
        <Image src={wordmark} alt="" height={11} densities={[1, 2]} loading="eager" class="hidden min-[360px]:block" />
      </span>
      <button popovertarget="menu" popovertargetaction="hide" class="-mr-2 p-2" aria-label="Close menu"><Icon name="close" class="size-7" /></button>
    </div>
    <nav aria-label="Mobile" class="mt-6 grid">
      {menuLinks.map(([label, href], i) => <a href={href} aria-current={current(href)} style={`--i:${i}`} class="display py-1.5 text-5xl active:text-green aria-[current=page]:text-green">{label}</a>)}
      <p class="eyebrow mt-8 mb-2 text-muted" style={`--i:${menuLinks.length}`}>Services</p>
      {menuServices.map(([label, href], i) => <a href={href} aria-current={current(href)} style={`--i:${menuLinks.length + 1 + i}`} class="py-2 text-lg font-medium text-fg/80 active:text-green aria-[current=page]:text-green">{label}</a>)}
    </nav>
    <div class="sticky bottom-0 -mx-4 mt-8 border-t border-line bg-ink px-4 pt-4 sm:-mx-6 sm:px-6 pb-[max(1.5rem,env(safe-area-inset-bottom))]">
      <a href="/book-a-trial" class="btn w-full">Book a free trial</a>
      <div class="mt-3 grid grid-cols-2 gap-3 text-sm font-bold uppercase">
        <a href={`tel:${site.tel}`} class="flex items-center justify-center gap-2 border border-line py-3 active:bg-white/10"><Icon name="phone" class="size-5" />Call</a>
        <a href={site.whatsappUrl} class="flex items-center justify-center gap-2 border border-line py-3 text-green active:bg-white/10"><Icon name="chat" class="size-5" />WhatsApp</a>
      </div>
      <p class="mt-3 text-center text-sm text-muted">{site.hoursText}</p>
    </div>
  </div>
</header>

<script>
  // Same-page links (e.g. Pricing → /#packages on the homepage) don't load a new page, so close the menu ourselves.
  const menu = document.querySelector<HTMLElement>('#menu')!;
  menu.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) menu.hidePopover();
  });
</script>
