---
// Top of a home section: small label, heading (each line rises out of a mask as it scrolls in), optional intro and a
// link on the right (slot "end"). One heading size and one spacing rule for every section.
interface Props {
  label: string;
  lines: string[]; // the heading, one entry per line
  muted?: number; // index of a line shown in the muted colour
  intro?: string;
  light?: boolean; // on a paper (light) background
  class?: string;
}
const { label, lines, muted, intro, light, class: cls } = Astro.props;
---

<div class:list={['flex flex-wrap items-end justify-between gap-x-6 gap-y-4', cls]}>
  <div>
    <p class:list={['eyebrow', light ? 'text-ink/60' : 'text-green']}>{label}</p>
    <h2 class="display rise-lines mt-3 text-[clamp(2.75rem,7vw,6rem)]">
      {lines.map((line, i) => <><span><span style={`--i:${i}`} class:list={[i === muted && (light ? 'text-ink/45' : 'text-muted')]}>{line}</span></span>{' '}</>)}
    </h2>
  </div>
  {intro && <p class:list={['max-w-sm text-lg', light ? 'text-ink/75' : 'text-fg/70']}>{intro}</p>}
  <slot name="end" />
</div>
