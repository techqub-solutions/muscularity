---
// The client videos from site.json: a swipe row on phones, three columns from md up. Nothing loads until play.
// Phones: narrower cards (9:16 at full card width was 533 px tall), so the next video peeks in.
import site from '../content/site.json';
import SwipeHint from './SwipeHint.astro';
---

{site.videos.length > 0 && (
  <>
    <SwipeHint text={`${site.videos.length} client videos`} class="mb-4" />
    <ul class="swipe reveal md:grid-cols-3">
      {site.videos.map((v) => (
        <li class="max-md:w-[min(62vw,16rem)]!">
          <video controls playsinline preload="none" poster={v.poster} aria-label={v.title} class="aspect-[9/16] w-full bg-ink object-cover [clip-path:polygon(0_0,calc(100%-2.5rem)_0,100%_2.5rem,100%_100%,0_100%)]">
            <source src={v.src} type="video/mp4" />
          </video>
          <p class="mt-5 flex items-center justify-between gap-3">
            <span class="eyebrow text-green">Client review</span>
            <span class="bg-green px-2 py-1 text-xs font-bold uppercase text-ink">Results</span>
          </p>
          <h3 class="mt-3 text-xl font-extrabold uppercase font-stretch-[75%] lg:text-2xl">{v.title}</h3>
          <p class="mt-2 text-fg/70">{v.description}</p>
        </li>
      ))}
    </ul>
  </>
)}
