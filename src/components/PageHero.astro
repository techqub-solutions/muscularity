---
// Top of every inner page: breadcrumbs (+ BreadcrumbList schema), H1, intro, optional photo and actions (slot).
// The text fades in on load. The photo: from sm up it sits behind the text; on phones it is a slanted band under the text
// (a green slash uncovers it), or with band={false} (form pages) it stays a dark background so the form comes sooner.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  titleEnd?: string; // smaller second line inside the H1, e.g. "in Abu Dhabi" (keyword without a huge headline)
  crumbs: [string, string][]; // after Home, e.g. [['Services', '/#services'], ['Cross Fit', '/services/cross-fit']]
  eyebrow?: string;
  intro?: string;
  image?: ImageMetadata;
  band?: boolean;
}
const { title, titleEnd, crumbs, eyebrow, intro, image, band = true } = Astro.props;
const trail = [['Home', '/'], ...crumbs];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map(([name, href], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(href, Astro.site).href })),
};
---

<section class="relative isolate flex flex-col overflow-clip border-b border-line sm:block">
  {image && (
    <>
      <div class:list={[
        'slash-load overflow-hidden sm:absolute sm:inset-0 sm:-z-10',
        band ? 'relative order-last mx-4 mb-10 aspect-video [clip-path:polygon(0_0,calc(100%-2.5rem)_0,100%_2.5rem,100%_100%,0_100%)] sm:m-0 sm:aspect-auto sm:[clip-path:none]' : 'absolute inset-0 -z-10',
      ]}>
        <Image src={image} alt="" widths={[640, 1280, 1920]} sizes="100vw" loading="eager" class="size-full object-cover" />
      </div>
      <div class:list={['absolute inset-0 -z-10 sm:bg-transparent sm:bg-linear-to-r sm:from-ink sm:via-ink/85 sm:to-ink/30', band ? 'max-sm:hidden' : 'bg-ink/85']}></div>
    </>
  )}
  <div class:list={['mx-auto w-full max-w-7xl px-4 pt-6 sm:px-6 sm:pt-8 sm:pb-16 lg:pb-24', image && band ? 'pb-8' : 'pb-10']}>
    <nav aria-label="Breadcrumb" class="eyebrow animate-fade-up text-muted">
      <!-- Phones: one line; a long last item (blog post titles) is cut with "…" -->
      <ol class="flex gap-x-2 gap-y-1 whitespace-nowrap sm:flex-wrap sm:whitespace-normal">
        {trail.map(([name, href], i) =>
          i < trail.length - 1 ? <li class="shrink-0"><a href={href} class="-my-3.5 inline-block py-3.5 hover:text-fg">{name}</a> <span class="text-green">/</span></li> : <li aria-current="page" class="min-w-0 truncate text-fg sm:overflow-visible">{name}</li>,
        )}
      </ol>
    </nav>
    {eyebrow && <p class="eyebrow mt-8 animate-fade-up text-green [animation-delay:120ms] sm:mt-14">{eyebrow}</p>}
    <h1 class:list={['display max-w-5xl animate-fade-up [animation-delay:240ms]', title.length > 30 ? 'text-[clamp(2.5rem,5.5vw,5rem)]' : 'text-[clamp(3rem,8vw,7rem)]', eyebrow ? 'mt-4' : 'mt-8 sm:mt-14']}>{title}{titleEnd && <>{' '}<span class="mt-3 block text-[0.42em] tracking-normal text-green font-stretch-[85%] [word-spacing:0.1em]">{titleEnd}</span></>}</h1>
    {intro && <p class="mt-6 max-w-2xl animate-fade-up text-lg text-fg/80 [animation-delay:360ms] sm:text-xl">{intro}</p>}
    <slot />
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
